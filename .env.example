# Copy to .env. Never commit credentials or the signed organizer API URL.
DATASET_API_URL=
# Gemini demo via the OpenAI-compatible endpoint.
# Also supported: openai, openai_compatible, or ollama
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_REVIEW=true
# Optional cost per million tokens; leave blank if unknown.
AI_INPUT_PRICE=
AI_OUTPUT_PRICE=
PORT=8765

# Optional reasoning level for OpenAI-compatible APIs.
AI_REASONING_EFFORT=low
