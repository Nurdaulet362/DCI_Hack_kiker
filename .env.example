# Copy to .env. Never commit credentials or the signed organizer API URL.
DATASET_API_URL=
# Production profile: Ollama with Qwen3:30B on the NVIDIA/Brev server.
# Use SSH local port-forwarding when the server is remote.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:30b
AI_API_KEY=
AI_REVIEW=true
# Optional cost per million tokens; leave blank if unknown.
AI_INPUT_PRICE=
AI_OUTPUT_PRICE=
PORT=8765

# Optional reasoning level for OpenAI-compatible adapters only.
# AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT_SECONDS=300

# Ollama only: explicit context and thinking for the chosen GPU.
AI_CONTEXT_WINDOW=32768
AI_THINK=false
